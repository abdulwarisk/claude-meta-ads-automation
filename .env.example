# Route B only (Python script). Copy to .env and fill in. NEVER commit .env.
# System user token with ads_management (Business settings > Users > System users > Generate token)
META_ACCESS_TOKEN=
# Optional: only needed if you want appsecret_proof
META_APP_ID=
META_APP_SECRET=
# Ad account (numbers only or act_123...) and the Facebook Page the ads run from
META_AD_ACCOUNT_ID=
META_PAGE_ID=
